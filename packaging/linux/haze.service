[Unit]
Description=haze latency and loss monitor
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/haze run /etc/haze/config.toml
DynamicUser=yes
StateDirectory=haze
WorkingDirectory=/var/lib/haze
Environment=HAZE_DATA=/var/lib/haze
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
